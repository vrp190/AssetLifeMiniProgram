.summary {
  margin-bottom: 22rpx;
}
.sum-row {
  display: flex;
  text-align: center;
}
.sum-item {
  flex: 1;
}
.sum-value {
  font-size: 32rpx;
  font-weight: 700;
}
.sum-value.accent {
  color: #4E7D12;
}
.sum-cap {
  font-size: 21rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
}
.chart-card {
  margin-bottom: 22rpx;
}
.chart-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.chart-title {
  font-size: 28rpx;
  font-weight: 600;
}
.chart-sub {
  font-size: 21rpx;
  color: #8A8A8A;
}
.cat-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}
.cat-icon {
  font-size: 34rpx;
  margin-right: 18rpx;
}
.cat-main {
  flex: 1;
  min-width: 0;
}
.cat-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.cat-name {
  font-size: 25rpx;
}
.cat-total {
  font-size: 24rpx;
  font-weight: 600;
}
.cat-bar {
  height: 12rpx;
  background: #F0F0F2;
  border-radius: 999rpx;
  margin-top: 10rpx;
  overflow: hidden;
}
.cat-fill {
  height: 100%;
  background: #9BE52E;
  border-radius: 999rpx;
}
.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F2F4;
}
.rank-row:last-child {
  border-bottom: none;
}
.rank-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.rank-name {
  flex: 1;
  font-size: 26rpx;
  margin-right: 14rpx;
}
.rank-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #4E7D12;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
