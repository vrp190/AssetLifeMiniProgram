.wish-summary {
  margin-bottom: 24rpx;
}
.wish-row {
  display: flex;
  text-align: center;
}
.wish-item {
  flex: 1;
}
.wish-value {
  font-size: 34rpx;
  font-weight: 700;
}
.wish-cap {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
}
.wish-note {
  font-size: 20rpx;
  color: #8A8A8A;
  margin-top: 18rpx;
}
.list > view {
  margin-bottom: 18rpx;
}
.list-foot {
  text-align: center;
  font-size: 21rpx;
  margin: 6rpx 0 20rpx;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: #9BE52E;
  color: #171717;
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(78, 125, 18, 0.35);
  z-index: 10;
}
.fab-hover {
  transform: scale(0.94);
}
