.acard {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #ECECF0;
  border-radius: 34rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}
.icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: rgba(155, 229, 46, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.grow {
  flex: 1;
  min-width: 0;
  margin-right: 18rpx;
}
.name-row {
  display: flex;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 12rpx;
  flex-shrink: 1;
}
.sub {
  font-size: 23rpx;
  color: #8A8A8A;
  margin-top: 8rpx;
}
.right {
  text-align: right;
  flex-shrink: 0;
}
.money {
  font-size: 28rpx;
  font-weight: 600;
  color: #171717;
  font-variant-numeric: tabular-nums;
}
.caption {
  font-size: 21rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pill {
  display: inline-block;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.pill-inUse {
  color: #4E7D12;
  background: rgba(155, 229, 46, 0.16);
}
.pill-retired {
  color: #E09F3E;
  background: rgba(224, 159, 62, 0.16);
}
.pill-sold {
  color: #5B7C99;
  background: rgba(91, 124, 153, 0.16);
}
