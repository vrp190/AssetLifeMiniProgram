.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
.stat-cell {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 10rpx 0 18rpx;
}
.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 21rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}
.stat-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8A8A8A;
  margin-bottom: 16rpx;
}
.stat-line:last-child {
  margin-bottom: 0;
}
.stat-warn {
  color: #C74A4A;
}
.pref-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pref-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}
.pref-title {
  font-size: 26rpx;
}
.pref-hint {
  font-size: 21rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
}
.pref-value {
  font-size: 24rpx;
  color: #4E7D12;
  white-space: nowrap;
}
.btn-block {
  margin-bottom: 18rpx;
}
.btn-block:last-child {
  margin-bottom: 0;
}
.glossary-item {
  display: flex;
  margin-bottom: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
}
.glossary-item:last-child {
  margin-bottom: 0;
}
.glossary-key {
  color: #4E7D12;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.import-box {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #EFEFEF;
}
.import-hint {
  font-size: 22rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
}
.import-area {
  width: 100%;
  box-sizing: border-box;
  height: 240rpx;
  background: #F5F5F7;
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  margin-bottom: 18rpx;
}
.about {
  text-align: center;
  padding: 44rpx 0 20rpx;
}
.about-title {
  font-size: 28rpx;
  font-weight: 700;
}
.about-sub {
  font-size: 21rpx;
  margin-top: 8rpx;
}
