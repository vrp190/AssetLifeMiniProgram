.summary {
  margin-bottom: 24rpx;
}
.sum-row {
  display: flex;
  text-align: center;
}
.sum-item {
  flex: 1;
}
.sum-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #171717;
}
.sum-value.accent {
  color: #4E7D12;
}
.sum-cap {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
}
.sum-note {
  font-size: 20rpx;
  color: #8A8A8A;
  margin-top: 18rpx;
}
.status-bar {
  display: flex;
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 24rpx;
  background: #F0F0F2;
}
.seg-inUse {
  background: #9BE52E;
}
.seg-retired {
  background: #E09F3E;
}
.seg-sold {
  background: #5B7C99;
}
.status-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #171717;
}
.legend-item.muted {
  color: #B9B9BE;
}

.toolbar {
  margin-bottom: 20rpx;
}
.search {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #ECECF0;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-clear {
  color: #8A8A8A;
  font-size: 26rpx;
  padding: 0 8rpx;
}
.filter-line {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}
.sort-picker {
  flex-shrink: 0;
  margin-left: 8rpx;
}
.sort-btn {
  font-size: 23rpx;
  color: #4E7D12;
  background: rgba(155, 229, 46, 0.16);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  white-space: nowrap;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.list > view {
  margin-bottom: 18rpx;
}
.list-foot {
  text-align: center;
  font-size: 21rpx;
  margin: 6rpx 0 20rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: #9BE52E;
  color: #171717;
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(78, 125, 18, 0.35);
  z-index: 10;
}
.fab-hover {
  transform: scale(0.94);
}
